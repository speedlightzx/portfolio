---
import { RedirectIcon } from '@/shared/components/RedirectIcon';
import galaxy from '../../assets/earth.gif';
---

<main class="w-full h-screen">
    <div class="fixed -z-10 w-full h-screen">
        <img src={galaxy.src} alt="background galaxy" class="w-full h-full object-cover brightness-50">
    </div>

    <div class="flex w-full h-full justify-center">
        <div class="mt-[15%] sm:mt-[10%] lg:mt-[6%] flex gap-y-15 flex-col w-full items-center">
            <h1 class="text-2xl md:text-3xl text-white font-bold">Contatos</h1>
            <div class="flex flex-col items-center justify-center gap-y-10">
                <h1 class="text-2xl md:text-2xl text-white font-bold w-[65%] text-center">Você pode entrar em contato comigo por um desses meios:</h1>
                <div class="flex justify-center gap-x-5">
                    <RedirectIcon client:idle imagePath="/linkedin.svg" url="https://www.linkedin.com/in/allan-herbert-388631296/" alt="Perfil no linkedin" toolTipMessage="Clique para ver meu Linkedin" imageSize={12}/>
                    <RedirectIcon client:idle imagePath="/mail.svg" url="mailto:allanherbertbr@gmail.com" alt="Meu email" toolTipMessage="Clique para me mandar um email"/>
                </div>
            </div>
        </div>
    </div>
</main> 
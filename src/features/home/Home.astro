---
import Galaxy from "./components/Galaxy";
import { RedirectIcon } from "../../shared/components/RedirectIcon"
import { TechnologiesLoop } from "./components/TechnologiesLoop";
import { MainSkillAndWhatSolves } from "./components/MainSkillAndWhatSolves";
import { Button } from "@/components/ui/button";
---

<main class="w-full relative h-screen">
    <div class="bg-black absolute w-full h-screen -z-10">
        <Galaxy
        density={3}
        glowIntensity={0.4}
        saturation={1}
        hueShift={170}
        twinkleIntensity={1}
        rotationSpeed={0}
        autoCenterRepulsion={20}
        starSpeed={0.2}
        client:load/>
    </div>

    <div class="flex w-full h-screen">
        <div class="flex flex-col mt-[15%] w-full pb-1">

            <div class="flex flex-col text-center gap-y-7">
                <div class="flex flex-col">
                    <h1 class="text-[#0DBE1F] text-6xl font-bold">{"<Allan Herbert />"}</h1>
                    <h2 class="text-4xl font-bold text-white">Desenvolvedor Full Stack</h2>
                </div>
                <div class="flex flex-col text-2xl gap-y-1">
                    <MainSkillAndWhatSolves client:visible/>
                </div>
            </div>

            <div class="flex justify-center items-center gap-x-8 mt-10">
                <div class="w-28 border-t-2 border-white"/>
                <div class="flex gap-x-5">
                    <RedirectIcon client:visible imagePath="/github.svg" url="https://github.com" alt="Github" toolTipMessage="Veja meu GitHub"/>
                    <RedirectIcon client:visible imagePath="/linkedin.svg" url="https://linkedin.com" alt="Linkedin" toolTipMessage="Veja meu Linkedin"/>
                </div>
                <div class="w-28 border-t-2 border-white"/>
            </div>

            <div class="flex justify-center w-full text-white font-bold mt-15">
                <p class="w-[35%] text-[#B2BEB5] text-[18px] text-center italic opacity-60">Transformo ideias em sistemas que funcionam de verdade, construídos do seu jeito.</p>
            </div>

            <div class="mt-auto w-full rounded-md p-3">
                <TechnologiesLoop client:load/>
            </div>
        </div>
    </div>

    <div class="bg-black pb-15">
        <div class="pt-25">
            <div class="w-full flex flex-col items-center gap-y-6">
                <div class="flex flex-col items-center">
                    <h1 class="text-white font-bold text-3xl">Sobre mim</h1>
                    <p class="text-white text-center max-w-[75%]">
        Olá! Me chamo Allan e sou Desenvolvedor Full Stack.
        Desenvolvo landing pages, sistemas web e bots personalizados, transformando problemas reais em soluções funcionais e eficientes.

        Trabalho com diferentes tecnologias de forma estratégica, escolhendo ferramentas e abordagens de acordo com o nível de complexidade do projeto, desde soluções mais simples e diretas até sistemas mais robustos e escaláveis.
        Tenho como foco a construção de aplicações performáticas, bem estruturadas e com boa experiência de uso.
                    </p>
                </div>

                <div class="flex justify-center w-full">
                    <Button className="hover:cursor-pointer" variant={'outline'} size={'default'}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download-icon lucide-download"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
                        Baixar currículo
                    </Button>
                </div>
            </div>
        </div>
    </div>    
</main>